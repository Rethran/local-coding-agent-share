{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-agent.invalid/schemas/task.schema.json",
  "title": "Local Coding Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "summary",
    "dependsOn",
    "description",
    "scope",
    "acceptanceCriteria",
    "constraints",
    "verification",
    "subtasks"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,11}-[0-9]{3}$"},
    "type": {"const": "task"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "dependsOn": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 1200},
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "acceptanceCriteria": {"type": "string", "minLength": 1, "maxLength": 1200},
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "workerGuidance": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/subtask"}
    },
    "implementationLogic": {"$ref": "#/$defs/implementationLogic"}
  },
  "$defs": {
    "targetArtifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1},
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "test": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1}
      }
    },
    "relatedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "legacySymbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "relevantLines"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "relevantLines": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"}
      }
    },
    "subtask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "readLegacy",
        "targetArtifacts",
        "scope",
        "verification",
        "instructions"
      ],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "summary": {"type": "string", "minLength": 1, "maxLength": 600},
        "readLegacy": {"type": "boolean"},
        "targetArtifacts": {"$ref": "#/$defs/targetArtifacts"},
        "relatedArtifacts": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/relatedArtifact"}
        },
        "legacySymbols": {
          "type": "array",
          "items": {"$ref": "#/$defs/legacySymbol"}
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "dataExamples": {"type": "array"},
        "businessRules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "implementationLogic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetModules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "businessRules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verificationCommands": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
